# PostgreSQL (pgvector)
DB_PASSWORD=darkmem
DATABASE_URL=postgresql+asyncpg://darkmem:darkmem@localhost:5433/darkmem
TEST_DATABASE_URL=postgresql+asyncpg://darkmem:darkmem@localhost:5433/darkmem_test

# LLM — per-purpose provider config (JSON strings)
# Each supports: provider, base_url, model, api_key, dimensions (embedding only), params
LLM_EMBEDDING={"provider":"ollama","base_url":"http://localhost:11434/v1","model":"qwen3-embedding:0.6b","dimensions":1024}
LLM_EXTRACTION={"provider":"ollama","base_url":"http://localhost:11434/v1","model":"llama3.2:3b","params":{"temperature":0.2}}
LLM_REASONING={"provider":"ollama","base_url":"http://localhost:11434/v1","model":"llama3.2:3b","params":{"temperature":0.7}}
LLM_SUMMARIZATION={"provider":"ollama","base_url":"http://localhost:11434/v1","model":"llama3.2:3b","params":{"temperature":0.3}}
LLM_RERANKER={"provider":"ollama","base_url":"http://localhost:11434/v1","model":"llama3.2:3b","params":{"temperature":0}}

# Security
JWT_SECRET=change-me-to-a-32-character-secret
SETUP_SECRET=
