# ── darkmem environment ────────────────────────────────────────────────
# Copy to .env and fill in. For a PRODUCTION deploy, every value under
# "Production-critical" below must be set to a strong, unique value.
#
# Runtime LLM configuration is NOT set here — it is managed in the database
# via the first-run setup wizard (/setup) and the Settings → LLM Pipeline UI.
# (Legacy LLM_* env vars were removed; they are no longer read.)

# ── Production-critical ────────────────────────────────────────────────
# Arms the fail-fast security validators (JWT strength, SETUP_SECRET required)
# and the Secure session-cookie flag. MUST be "production" for any real deploy.
ENVIRONMENT=production

# Postgres password — use a long random value, not the dev default.
#   openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_strong_db_password

# JWT signing secret — MUST be >= 32 chars and not a default/placeholder, or the
# app refuses to boot in production. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_32plus_char_random_secret

# Setup-wizard secret — REQUIRED in production. Gates the one-shot /setup admin
# bootstrap so it can't be claimed by anyone on the network. Generate with:
#   openssl rand -hex 32
SETUP_SECRET=CHANGE_ME_generate_a_random_secret

# ── Connection / proxy ─────────────────────────────────────────────────
# Used by docker-compose to build the api↔postgres URL (service name "postgres").
DATABASE_URL=postgresql+asyncpg://darkmem:${DB_PASSWORD}@postgres:5432/darkmem

# Honor X-Forwarded-For from a trusted reverse proxy (the bundled nginx, or your
# own TLS proxy) so the login rate limiter sees the real client IP. Set to false
# ONLY if the API is exposed with no trusted proxy in front.
TRUST_PROXY_HEADERS=true

# Cross-origin browser origins for the API (comma-separated). Usually leave EMPTY:
# the bundled UI is same-origin behind nginx and uses a relative /api/v1 path.
# Set only if a browser on a different origin must call the API directly.
CORS_ORIGINS=

# Image tag used by docker-compose.yml (pin to a release, e.g. 0.2.0, in prod).
DARKMEM_VERSION=latest

# Log level for application loggers (DEBUG|INFO|WARNING|ERROR).
LOG_LEVEL=INFO

# ── Local development only ─────────────────────────────────────────────
# Used by the test suite (docker-compose.dev.yml / local pytest). Not needed in prod.
TEST_DATABASE_URL=postgresql+asyncpg://darkmem:darkmem@localhost:5433/darkmem_test
