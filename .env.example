# ── darkmem environment ────────────────────────────────────────────────
# Copy to .env and fill in the three secrets below. docker-compose reads this
# file automatically. Runtime LLM configuration is NOT set here — it is managed
# in the database via the first-run setup wizard (/setup) and the
# Settings → LLM Pipeline UI.

# ── Required secrets (generate a unique value per deployment) ───────────
# Postgres password.                openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_strong_db_password
# JWT signing secret, 32+ chars.    openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_32plus_char_random_secret
# Note: /setup is open trust-on-first-use — the first caller to finish the
# wizard claims the admin account, so there is no setup secret to configure.

# ── Database connection ────────────────────────────────────────────────
# The API builds DATABASE_URL from these. Defaults shown; uncomment to change.
# DB_HOST points at the bundled compose service; set it to a hostname/IP to use
# an external Postgres instead. (DB_PASSWORD is set above.)
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=darkmem
# DB_NAME=darkmem

# ── Access ─────────────────────────────────────────────────────────────
# The session cookie is HTTPS-only by default. If you reach darkmem over plain
# HTTP on your LAN (no TLS reverse proxy in front), set this to false or login
# will silently fail. Trade-off: the cookie is then sent in cleartext on the LAN.
COOKIE_SECURE=true

# Hosts allowed to reach the MCP endpoint (/mcp) — a DNS-rebinding allowlist.
# Empty allows only localhost, so agents on other LAN machines are rejected.
# Set your host:port to let them connect, e.g. MCP_ALLOWED_HOSTS=192.168.0.195:8000
# (or 192.168.0.195:* for any port). Set to * to disable the host check entirely.
MCP_ALLOWED_HOSTS=

# ── Optional ───────────────────────────────────────────────────────────
# Image tag deployed by docker-compose.yml (pin to a release in production).
# DARKMEM_VERSION=latest
# Application log level: DEBUG|INFO|WARNING|ERROR.
# LOG_LEVEL=INFO

# ── Local development / tests only (not used by the production stack) ───
# Host-side pytest and docker-compose.dev.yml.
# TEST_DATABASE_URL=postgresql+asyncpg://darkmem:darkmem@localhost:5433/darkmem_test
# DATABASE_URL is derived from the DB_* vars above. Set it explicitly only to
# override them wholesale (e.g. a different driver or a full external URL):
# DATABASE_URL=postgresql+asyncpg://darkmem:PASSWORD@HOST:5432/darkmem
