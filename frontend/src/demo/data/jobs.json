  {
    "key": "expired_memory_cleanup",
    "name": "Expired Memory Cleanup",
    "description": "Deletes memories past their expires_at TTL. Dependents pointing at a doomed row via superseded_by are demoted to deprecated first, per chk_superseded_has_pointer.",
    "enabled": true,
    "cron": "0 * * * *",
    "cron_label": "hourly, on the hour",
    "min_interval_seconds": 300,
    "max_run_seconds": 300,
    "running": false,
    "lock_held_since": null,
    "next_run_label": "next 15:00 UTC (unaffected)",
    "last_run_label": "14:00 UTC",
    "last_status": "error",
    "last_summary": "failed: chk_superseded_has_pointer violation, 1 dependent memory was not demoted before delete",
    "config_schema": [
      {
        "key": "batch_limit",
        "type": "int",
        "label": "batch_limit",
        "value": 200,
        "min": 10,
        "max": 1000,
        "help": "Expired rows deleted per sweep (dependents demoted first)."
      }
    ]
  },
